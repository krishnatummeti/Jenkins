pipeline {
    agent { label 'AGENT-01' }

    options {
        skipStagesAfterUnstable()
    }

    stages {
        stage('Build') {
            steps {
                script {
                    // Ensure we run Maven inside the project folder where pom.xml exists
                    dir('06_springboot-maven-demo') {
                        sh 'mvn -B clean package -DskipTests'
                    }
                }
            }
        }

        stage('Test') {
            steps {
                dir('06_springboot-maven-demo') {
                    sh 'mvn test'
                }
            }
            post {
                always {
                    // Archive JUnit XML reports
                    junit '06_springboot-maven-demo/**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Deliver') {
            steps {
                dir('06_springboot-maven-demo') {
                    sh './jenkins/scripts/deliver.sh'
                }
            }
        }
    }
}
